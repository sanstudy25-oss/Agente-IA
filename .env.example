# ============================================================
#  .env.example — copie como .env (cp .env.example .env)
#  El archivo .env NUNCA debe subirse a GitHub.
# ============================================================

# ── Proveedor LLM: ollama (local, por defecto) | groq (API) ──
LLM_PROVIDER=ollama

# Ollama (local) — instale desde https://ollama.com y ejecute: ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Groq (alternativa) — clave en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

TEMPERATURE=0.2
MAX_TOKENS=2048

# ── Identidad del agente ──
AGENT_NAME=POSTO-Comercial
AGENT_ROLE=asistente de inteligencia artificial del área comercial de Postobón S.A.

# ── Memoria por sesión: buffer (todo) | window (últimos N mensajes) ──
MEMORY_TYPE=window
MEMORY_WINDOW_SIZE=10

# ── RAG ──
TAMANO_FRAGMENTO=900
SUPERPOSICION_FRAGMENTO=120
K_FRAGMENTOS=5
# tfidf = vectores locales sin descargas | ollama = embeddings neuronales (ollama pull nomic-embed-text)
EMBEDDINGS_PROVIDER=tfidf
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Carpetas (opcional) ──
DOCUMENTOS_DIR=data/documentos
VENTAS_DIR=data/ventas
PROCESADOS_DIR=data/procesados
REPORTES_DIR=data/reportes

# ── Cargas y servidor ──
MAX_UPLOAD_MB=25
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=True
